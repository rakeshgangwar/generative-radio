# Local-only defaults. Change passwords before exposing the server.
ICECAST_SOURCE_PASSWORD=local-source-change-me
ICECAST_ADMIN_PASSWORD=local-admin-change-me
SEGMENT_SECONDS=120
BUFFER_SECONDS=1200
BPM=60
STATION_SEED=20261114

# Decoded-audio watchdog; defaults tolerate startup, fades and brief outages.
WATCHDOG_GRACE_SECONDS=90
WATCHDOG_PROBE_SECONDS=12
WATCHDOG_INTERVAL_SECONDS=30
WATCHDOG_TIMEOUT_SECONDS=20
WATCHDOG_FAILURES=3
WATCHDOG_RESTART_LIMIT=3
WATCHDOG_RESTART_WINDOW_SECONDS=900
