(station) {
	root * /srv
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}
	@stream {
		path /radio.mp3
		method GET HEAD
	}
	handle @stream {
		reverse_proxy icecast:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 10s
			}
		}
	}
    @context {
        path /broadcast.json
        method GET HEAD
    }
    handle @context {
        rewrite * /broadcast-context-json.xsl
        reverse_proxy icecast:8000 {
            header_down Content-Type application/json
            header_down Cache-Control no-store
            transport http {
                response_header_timeout 3s
            }
        }
    }
	handle {
		file_server
	}
}
